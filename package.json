{
  "name": "loongarch-b1",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "description": "基于大模型技术的软件实训教学结果检查评价与报表系统",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "bundle:runtime": "node scripts/build-runtime-bundle.mjs",
    "docker:build": "docker build --target runtime -t loongarch-b1:local .",
    "db:migrate": "pnpm --filter @loongarch-b1/api db:migrate",
    "worker:parse": "pnpm --filter @loongarch-b1/api worker:parse",
    "worker:evaluate": "pnpm --filter @loongarch-b1/api worker:evaluate",
    "worker:export": "pnpm --filter @loongarch-b1/api worker:export",
    "worker:all": "pnpm --filter @loongarch-b1/api worker:all",
    "risk:loongarch": "node scripts/loongarch-dependency-risk.mjs --write docs/LOONGARCH_DEPENDENCY_RISK.md"
  },
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.17",
    "eslint": "10.3.0",
    "eslint-plugin-vue": "10.9.0",
    "globals": "17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1",
    "vue-eslint-parser": "10.4.0"
  }
}
