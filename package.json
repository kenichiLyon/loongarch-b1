{
  "name": "loongarch-b1",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "description": "基于大模型技术的软件实训教学结果检查评价与报表系统",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm build",
    "db:migrate": "pnpm --filter @loongarch-b1/api db:migrate"
  },
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "typescript": "5.9.3"
  }
}
