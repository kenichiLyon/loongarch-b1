[Unit]
Description=loongarch-b1 API and Web
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/loongarch-b1
EnvironmentFile=/opt/loongarch-b1/.env
ExecStart=/usr/bin/node /opt/loongarch-b1/apps/api/dist/main.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
