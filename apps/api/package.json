{
  "name": "@loongarch-b1/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "worker:parse": "tsx src/workers/parse-artifacts.ts",
    "worker:evaluate": "tsx src/workers/evaluate-submissions.ts",
    "worker:export": "tsx src/workers/export-reports.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "multer": "2.1.1",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/multer": "2.1.0",
    "@types/pg": "8.20.0",
    "tsx": "4.21.0"
  }
}
